# Database
DATABASE_URL="postgresql://username:password@localhost:5432/nova?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-for-access-tokens"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string-for-refresh-tokens"

# Token Expiry (in seconds or zeit/ms format)
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT="4000"
NODE_ENV="development"

# CORS - comma-separated allowed origins
CORS_ORIGIN="http://localhost:5173"

# Cookie
COOKIE_SECURE="false"
